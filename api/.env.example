# Copy to .env and adjust. Never commit the real .env.
PORT=4000

# Ports 5433 / 27018 = the Docker containers (docker-compose.yml). They are not
# the defaults so they don't clash with databases already installed on the PC.
# Running PostgreSQL/MongoDB installed directly instead? Use 5432 / 27017 and
# your own password.

# PostgreSQL (same variable names as the inherited seeders)
PGHOST=localhost
PGPORT=5433
PGDATABASE=gigtask
PGUSER=postgres
PGPASSWORD=gigtask

# MongoDB (same variable names as the inherited seeders)
MONGO_URI=mongodb://localhost:27018/
MONGO_DB=gigtask
